# Always keep shell scripts with LF — CRLF breaks bash on Linux/WSL2
*.sh         text eol=lf
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.py         text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.toml       text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.css        text eol=lf
*            text=auto
