# Prevent npm from getting stuck on network issues
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
network-timeout=300000

# Reduce concurrent connections to avoid overwhelming the network
maxsockets=5

# Reduce log noise during builds
loglevel=error

# Disable audit and funding messages during install (speeds up)
audit=false
fund=false

# Use offline mode when possible (after first install)
prefer-offline=true

# Disable progress bars in CI/Docker environments
progress=false
