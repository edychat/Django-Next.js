# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
.pytest_cache/
*.so
.Python

# Virtual environments
.env
.venv/
venv/
env/
*.egg-info/
.eggs/

# Development files
*.swp
*.swo
*.DS_Store
.idea/
.vscode/

# Test files
tests/
test_*.py
*_test.py

# Documentation
docs/
*.md
README*

# Media and data files (large files that shouldn't be in the image)
media/
config/staticfiles/
backup/db/
backup/snapshots/
# Allow backup files in start directory for deployment restore
backup/start/*.log
backup/start/backup_*
!backup/start/*.sql.gz
!backup/start/*.sql
!backup/start/*.tar.gz

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
railway.toml

# Docker files (already in use, no need to copy)
Dockerfile*
docker-compose*.yml
.dockerignore
